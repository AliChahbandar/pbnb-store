# Shopify — Storefront API (public token, safe in browser)
SHOPIFY_STORE_DOMAIN=pbnb-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# Shopify — Admin API (SERVER ONLY. never expose to client code)
SHOPIFY_ADMIN_TOKEN=

# Pinned API version. Verified latest stable on shopify.dev (2026-10 is RC).
SHOPIFY_API_VERSION=2026-07
