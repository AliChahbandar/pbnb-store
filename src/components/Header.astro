---
import { CART_COOKIE, getCart } from '../lib/cart';

const cartId = Astro.cookies.get(CART_COOKIE)?.value ?? null;
const { cart } = await getCart(cartId, { request: Astro.request, locals: Astro.locals });
const count = cart?.totalQuantity ?? 0;

const nav = [
  { href: '/collections/new', label: 'New' },
  { href: '/collections/tees', label: 'Tees' },
  { href: '/collections/hoodies', label: 'Hoodies' },
  { href: '/collections/bottoms', label: 'Bottoms' },
  { href: '/collections/accessories', label: 'Accessories' },
  { href: '/collections/all', label: 'Everything' },
];
const path = Astro.url.pathname;
---

<header class="hd">
  <div class="hd__bar wrap">
    <a class="hd__logo" href="/" aria-label="PB&amp;B — home">
      <img src="/logo-wordmark.svg" alt="" width="1754" height="642" />
    </a>

    <nav class="hd__nav" aria-label="Primary">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hd__util">
      <a class="hd__ico" href="/search" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </a>
      <a class="hd__ico hd__cart" href="/cart" aria-label={`Cart, ${count} item${count === 1 ? '' : 's'}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M5 7h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 7Z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></path>
          <path d="M9 7V5.6A3 3 0 0 1 12 3a3 3 0 0 1 3 2.6V7" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
        <span class="hd__count" data-cart-count hidden={count === 0}>{count}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid var(--rule-soft);
  }
  .hd__bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: 64px;
  }
  .hd__logo {
    display: block;
    width: clamp(84px, 9vw, 124px);
  }
  .hd__logo img {
    width: 100%;
    height: auto;
  }
  .hd__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.6vw, 1.9rem);
    list-style: none;
    padding: 0;
    justify-content: center;
  }
  .hd__nav a {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-dim);
    padding-block: 0.4rem;
    border-block-end: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .hd__nav a:hover,
  .hd__nav a[aria-current='page'] {
    color: var(--ink);
    border-block-end-color: var(--berry);
  }
  .hd__util {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hd__ico {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: var(--ink-dim);
    border-radius: var(--radius);
    transition: color 0.15s, background 0.15s;
  }
  .hd__ico:hover {
    color: var(--ink);
    background: var(--bg-raised);
  }
  .hd__ico svg {
    width: 21px;
    height: 21px;
  }
  .hd__count {
    position: absolute;
    inset-block-start: 4px;
    inset-inline-end: 2px;
    min-width: 17px;
    height: 17px;
    padding-inline: 4px;
    display: grid;
    place-items: center;
    background: var(--berry);
    color: #fff;
    border-radius: 99px;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .hd__bar {
      grid-template-columns: auto auto;
      row-gap: 0.25rem;
      padding-block: 0.6rem;
    }
    .hd__nav {
      grid-column: 1 / -1;
      order: 3;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
    }
    .hd__nav::-webkit-scrollbar {
      display: none;
    }
    .hd__nav ul {
      flex-wrap: nowrap;
      justify-content: flex-start;
    }
    .hd__util {
      justify-self: end;
    }
  }
</style>
