---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from '../lib/catalog';

const ctx = { request: Astro.request, locals: Astro.locals };
const { data: newIn } = await getCollection('new', { first: 4 }, ctx);
const { data: all } = await getCollection('all', { first: 8 }, ctx);

const featured = newIn.collection?.products ?? [];
const rest = (all.collection?.products ?? []).filter(
  (p) => !featured.some((f) => f.handle === p.handle),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PB&B',
    url: 'https://pbnb.store',
    logo: 'https://pbnb.store/icon-512.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'PB&B',
    url: 'https://pbnb.store',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://pbnb.store/search?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<Base
  title="PB&B"
  description="Heavyweight graphic tees, cropped zip hoodies and baggy denim. Drawn by hand, printed big, made in small runs."
  jsonLd={jsonLd}
>
  <!-- HERO
       Split panel rather than a full-bleed image: the garment flats sit on a
       bone ground, and floating that behind dark type just muddies both. The
       image is the LCP element — eager, high priority, and deliberately given
       no entry animation, since animating its opacity from 0 would push LCP
       out by the length of the animation. -->
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">Drop 01</p>
      <h1 class="display hero__h1">Wear it<br />loud</h1>
      <p class="lede">
        Full-back graphics on heavyweight cotton. Cropped zip fleece. Baggy denim with the
        scrollwork climbing the leg. Drawn by hand, printed big, made in small runs.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/collections/new">Shop the drop</a>
        <a class="btn btn--ghost" href="/collections/all">Everything</a>
      </div>
    </div>
    <div class="hero__media">
      <img
        src="/product-designs/pbnb-nova-star-tee-charcoal-back.webp"
        alt="Nova Star Tee in charcoal, back view: an orange five-point star cut through with magenta plaid tribal spines"
        width="1600"
        height="1600"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
  </section>

  <!-- FEATURED -->
  {
    featured.length > 0 && (
      <section class="section wrap">
        <header class="sec__head" data-reveal>
          <h2 class="h2">New in</h2>
          <a class="sec__more" href="/collections/new">
            All new <span aria-hidden="true">&rarr;</span>
          </a>
        </header>
        <div class="grid grid--4">
          {featured.map((p, i) => (
            <div data-rise>
              <ProductCard product={p} priority={i === 0} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- EDITORIAL BREAK -->
  <section class="ed">
    <div class="ed__img" data-drift>
      <img
        src="/product-designs/pbnb-ironwork-hoodie-charcoal-back.webp"
        alt="Ironwork Zip Hoodie in charcoal, back view: a wrought-iron moth motif in bone and deep berry"
        width="1600"
        height="1600"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="ed__copy" data-reveal>
      <p class="eyebrow">The fleece</p>
      <h2 class="h2">Cropped, boxy,<br />built heavy</h2>
      <p>
        A short body and a wide sleeve, cut so the graphic sits flat across the back instead of
        wrapping the ribs. Studded cuff edge, kangaroo pocket, and a fleece weight that holds its
        line after a wash.
      </p>
      <a class="btn btn--ghost" href="/collections/hoodies">See the hoodies</a>
    </div>
  </section>

  <!-- REST OF RANGE -->
  {
    rest.length > 0 && (
      <section class="section wrap">
        <header class="sec__head" data-reveal>
          <h2 class="h2">The rest of it</h2>
          <a class="sec__more" href="/collections/all">
            Everything <span aria-hidden="true">&rarr;</span>
          </a>
        </header>
        <div class="grid grid--pair">
          {rest.map((p) => (
            <div data-rise>
              <ProductCard product={p} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- FIT PROMISE -->
  <section class="section wrap">
    <div class="promise" data-reveal>
      <div>
        <h2 class="h3">Not sure on size?</h2>
        <p>
          Every garment is measured flat and listed in inches, so you can lay a shirt you already
          own next to the numbers. If it lands wrong, the first exchange is on us.
        </p>
      </div>
      <div class="promise__cta">
        <a class="btn" href="/size-guide">Size guide</a>
        <a class="btn btn--ghost" href="/policies/refund">Exchanges</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: stretch;
    min-height: clamp(460px, 76svh, 820px);
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 4rem);
    padding-inline-start: max(var(--gut), calc((100vw - var(--maxw)) / 2 + var(--gut)));
  }
  .hero__h1 {
    margin-block: 0.5rem 1.1rem;
  }
  .hero__media {
    background: var(--paper);
    overflow: hidden;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1.75rem;
  }

  /* ---- sections ---- */
  .sec__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: clamp(1.25rem, 3vw, 2.25rem);
  }
  .sec__more {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .sec__more:hover {
    color: var(--ink);
  }
  .grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  /* The remainder is however many products are left over, so this track grows
     to fill instead of leaving dead columns. */
  .grid--pair {
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }

  /* ---- editorial ---- */
  .ed {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-inline: var(--gut);
    max-width: var(--maxw);
    margin-inline: auto;
    margin-block: var(--stack);
  }
  .ed__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper);
    border-radius: var(--radius);
  }
  .ed__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ed__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 44ch;
  }
  .ed__copy p {
    color: var(--ink-dim);
  }

  /* ---- promise ---- */
  .promise {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .promise p {
    color: var(--ink-dim);
    max-width: 52ch;
    margin-block-start: 0.6rem;
  }
  .promise__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 1100px) {
    .grid--4 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ed {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero__copy {
      order: 2;
      padding-inline: var(--gut);
    }
    .hero__media {
      order: 1;
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 420px) {
    .hero__cta .btn {
      flex: 1;
    }
  }
</style>
